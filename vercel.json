{
    "version": 2,
    "framework": "vite",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*).(pfm|exr)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}